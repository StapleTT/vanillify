<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Vanillify/Plugin.cs" Link="Plugin.cs" />
    <Compile Include="../Vanillify/PluginConfig.cs" Link="PluginConfig.cs" />
    <None Include="../Vanillify/manifest.json" Link="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Vanillify/Settings.bsml" Link="Settings.bsml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
